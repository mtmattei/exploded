<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop;net10.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>Exploded</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.mattmattei.exploded</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Exploded</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Exploded view parts catalog, built with Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      SkiaRenderer;
      Mvux;
    </UnoFeatures>
  </PropertyGroup>

  <!--
    In-app UI tests. Built only with -p:RuntimeTests=true, and only for the
    desktop head, so a normal build ships no runner and no test code. Run them
    with UNO_RUNTIME_TESTS_RUN_TESTS='{}' set (see RuntimeTests/README.md).
  -->
  <PropertyGroup Condition="'$(RuntimeTests)' == 'true' and '$(TargetFramework)' == 'net10.0-desktop'">
    <DefineConstants>$(DefineConstants);RUNTIME_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(RuntimeTests)' == 'true' and '$(TargetFramework)' == 'net10.0-desktop'">
    <PackageReference Include="Uno.UI.RuntimeTests.Engine" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeTests)' != 'true' or '$(TargetFramework)' != 'net10.0-desktop'">
    <Compile Remove="RuntimeTests/**" />
    <None Remove="RuntimeTests/**" />
  </ItemGroup>

</Project>
