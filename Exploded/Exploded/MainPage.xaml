<Page x:Class="Exploded.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:presentation="using:Exploded.Presentation"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:stage="using:Exploded.Stage"
      Background="{StaticResource Sweep}">

  <Page.Resources>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Callout}" />
      <Setter Property="Foreground" Value="{StaticResource Paper}" />
      <Setter Property="FontFamily" Value="{StaticResource Font.Label}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="16,11" />
      <Setter Property="CornerRadius" Value="{StaticResource Shape.Swatch}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="QuietButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontFamily" Value="{StaticResource Font.Label}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="CornerRadius" Value="{StaticResource Shape.Swatch}" />
    </Style>

    <presentation:TokenBrushConverter x:Key="TokenBrush" />
    <presentation:BoolToValueConverter x:Key="RowBackground" WhenTrue="{StaticResource RowSelected}" />
    <presentation:BoolToValueConverter x:Key="NumberBrush" WhenTrue="{StaticResource Callout}" WhenFalse="{StaticResource InkFaint}" />
    <presentation:BoolToValueConverter x:Key="ShownWhenTrue">
      <presentation:BoolToValueConverter.WhenTrue><Visibility>Visible</Visibility></presentation:BoolToValueConverter.WhenTrue>
      <presentation:BoolToValueConverter.WhenFalse><Visibility>Collapsed</Visibility></presentation:BoolToValueConverter.WhenFalse>
    </presentation:BoolToValueConverter>
    <presentation:BoolToValueConverter x:Key="ShownWhenFalse">
      <presentation:BoolToValueConverter.WhenTrue><Visibility>Collapsed</Visibility></presentation:BoolToValueConverter.WhenTrue>
      <presentation:BoolToValueConverter.WhenFalse><Visibility>Visible</Visibility></presentation:BoolToValueConverter.WhenFalse>
    </presentation:BoolToValueConverter>

    <!--
        One row of the parts table, bound to a PartLine. A ContentControl only to
        make the row a keyboard stop: panels cannot take focus. Focusing a row
        selects it, so Tab and the arrow keys walk the table the way a tap does.
    -->
    <DataTemplate x:Key="PartRowTemplate">
      <ContentControl IsTabStop="True"
                      UseSystemFocusVisuals="True"
                      FocusVisualPrimaryBrush="{StaticResource Callout}"
                      FocusVisualSecondaryBrush="{StaticResource Paper}"
                      HorizontalContentAlignment="Stretch"
                      Tapped="OnRowTapped"
                      GotFocus="OnRowFocused"
                      Loaded="OnRowLoaded"
                      KeyDown="OnRowKeyDown"
                      AutomationProperties.Name="{Binding AutomationName}">
        <Grid Background="{Binding IsSelected, Converter={StaticResource RowBackground}}"
              Padding="8,11"
              ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock Text="{Binding NumberLabel}"
                     Style="{StaticResource Data}"
                     Foreground="{Binding IsSelected, Converter={StaticResource NumberBrush}}"
                     VerticalAlignment="Top" />

          <Grid Grid.Column="1" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0">
            <Border Background="{Binding Swatch, Converter={StaticResource TokenBrush}}"
                    BorderBrush="{StaticResource Ink}"
                    BorderThickness="0.8"
                    CornerRadius="{StaticResource Shape.Swatch}" />
            <!-- out of stock: a 45 degree hatch, so stock is never colour alone -->
            <Path Data="M0,4 L4,0 M0,8 L8,0 M0,12 L12,0 M0,16 L16,0 M2,18 L18,2 M6,18 L18,6 M10,18 L18,10 M14,18 L18,14"
                  Stroke="{StaticResource Hatch}"
                  StrokeThickness="1"
                  Visibility="{Binding IsAvailable, Converter={StaticResource ShownWhenFalse}}" />
          </Grid>

          <StackPanel Grid.Column="2" Spacing="2">
            <TextBlock Text="{Binding Name}" Style="{StaticResource PartName}" />
            <TextBlock Text="{Binding Spec}" Style="{StaticResource Body}" FontSize="12" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,3,0,0">
              <TextBlock Text="{Binding Sku}" Style="{StaticResource Data}" FontSize="11" Foreground="{StaticResource InkFaint}" />
              <StackPanel Orientation="Horizontal" Spacing="5"
                          Visibility="{Binding IsInBuild, Converter={StaticResource ShownWhenTrue}}">
                <Rectangle Width="7" Height="7" Fill="{StaticResource Board}" VerticalAlignment="Center" />
                <TextBlock Text="IN BUILD" Style="{StaticResource Label}" FontSize="10" Foreground="{StaticResource Board}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="3" Spacing="3" HorizontalAlignment="Right">
            <TextBlock Text="{Binding PriceLabel}" Style="{StaticResource Money}" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource Label}" FontSize="10"
                       HorizontalAlignment="Right"
                       Foreground="{StaticResource InkFaint}" />
          </StackPanel>
        </Grid>
      </ContentControl>
    </DataTemplate>
  </Page.Resources>

  <Grid x:Name="Root" Padding="24" ColumnSpacing="24" MaxWidth="1500">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="StageColumn" Width="1.55*" />
      <ColumnDefinition x:Name="PartsColumn" Width="*" MinWidth="300" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!--
        Wide: the drawing and its parts table side by side. Narrow: the drawing
        on top at a capped height, the table below it filling the rest, so the
        table's own footer (total and Add) stays pinned to the bottom edge.
    -->
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="Layout">
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1000" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="Narrow">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="Root.Padding" Value="16" />
            <Setter Target="Root.RowSpacing" Value="16" />
            <Setter Target="Root.ColumnSpacing" Value="0" />
            <Setter Target="StageColumn.Width" Value="*" />
            <Setter Target="PartsColumn.Width" Value="0" />
            <Setter Target="PartsColumn.MinWidth" Value="0" />
            <Setter Target="StagePanel.(Grid.RowSpan)" Value="1" />
            <Setter Target="PartsPanel.(Grid.Row)" Value="1" />
            <Setter Target="PartsPanel.(Grid.RowSpan)" Value="1" />
            <Setter Target="PartsPanel.(Grid.Column)" Value="0" />
            <Setter Target="StageView.MaxHeight" Value="300" />
            <Setter Target="SeparationControl.(Grid.Column)" Value="0" />
            <Setter Target="SeparationControl.(Grid.ColumnSpan)" Value="2" />
            <Setter Target="TitleBlock.(Grid.Row)" Value="1" />
            <Setter Target="TitleBlock.HorizontalAlignment" Value="Left" />
            <Setter Target="TitleBlock.(Grid.ColumnSpan)" Value="2" />
            <Setter Target="ScaleLine.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <!-- the plate -->
    <Border x:Name="StagePanel"
        Grid.RowSpan="2"
        Background="{StaticResource Sweep}"
        BorderBrush="{StaticResource Rule}"
        BorderThickness="1"
        CornerRadius="{StaticResource Shape.Panel}"
        Padding="16">
      <Grid RowSpacing="16">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Fixed design size inside a Viewbox: every measurement in the drawing
            is written at its real number and the whole surface scales as one
            body, which keeps geometry and callout type pixel-registered.
        -->
        <Viewbox x:Name="StageView" Stretch="Uniform">
          <Grid Width="960" Height="440">

            <!--
                The whole stack is one canvas element. As five layers of XAML
                Paths it was five sheets of composition shape visuals, and Uno
                recomputes an anti-aliasing damage path for every shape visual
                whose transform changes, which cost about a blocking second of
                UI thread per step of the separation slider. Inside a canvas
                the sheets are drawing rather than visuals, so they are free to
                move.
            -->
            <stage:PlateCanvas x:Name="Plate"
                               Separation="{x:Bind Separation.Value, Mode=OneWay}"
                               SelectedLayer="{Binding SelectedLayer}"
                               Tapped="OnPlateTapped"
                               AutomationProperties.Name="Exploded plate" />

            <!--
                The callout system. Bubbles ride a fixed ladder rather than
                tracking their sheet: that is the drafting convention, and it is
                the only arrangement where they do not collide with each other
                halfway through the scrub, when sheets are a few pixels apart.
            -->
            <Canvas x:Name="Leaders" IsHitTestVisible="False"
                    Opacity="{x:Bind CalloutFade(Separation.Value), Mode=OneWay}">
              <Path Data="{x:Bind LeaderLine(Separation.Value, 4), Mode=OneWay}" Stroke="{StaticResource Callout}" StrokeThickness="1" />
              <Path Data="{x:Bind LeaderLine(Separation.Value, 3), Mode=OneWay}" Stroke="{StaticResource Callout}" StrokeThickness="1" />
              <Path Data="{x:Bind LeaderLine(Separation.Value, 2), Mode=OneWay}" Stroke="{StaticResource Callout}" StrokeThickness="1" />
              <Path Data="{x:Bind LeaderLine(Separation.Value, 1), Mode=OneWay}" Stroke="{StaticResource Callout}" StrokeThickness="1" />
              <Path Data="{x:Bind LeaderLine(Separation.Value, 0), Mode=OneWay}" Stroke="{StaticResource Callout}" StrokeThickness="1" />
            </Canvas>

            <Canvas x:Name="Bubbles" IsHitTestVisible="False"
                    Opacity="{x:Bind CalloutFade(Separation.Value), Mode=OneWay}" />
          </Grid>
        </Viewbox>

        <!--
            Title block and instrument sit outside the Viewbox so their type
            stays at real size however the drawing scales.
        -->
        <Grid Grid.Row="1" ColumnSpacing="24" RowSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border x:Name="TitleBlock" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="12,10">
            <StackPanel Spacing="3">
              <TextBlock Text="EXPLODED VIEW" Style="{StaticResource Label}" Foreground="{StaticResource Ink}" />
              <TextBlock Text="{Binding FormFactor, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource Label}" />
              <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                <TextBlock x:Name="ScaleLine" Text="SCALE 1:1" Style="{StaticResource Data}" FontSize="10" />
                <TextBlock Text="{Binding Revision, TargetNullValue='REV —', FallbackValue='REV —'}" Style="{StaticResource Data}" FontSize="10" />
                <TextBlock Text="SHEET 1 OF 1" Style="{StaticResource Data}" FontSize="10" />
              </StackPanel>
            </StackPanel>
          </Border>

          <StackPanel x:Name="SeparationControl" Grid.Column="1" Spacing="4" VerticalAlignment="Center">
            <Grid>
              <TextBlock Text="SEPARATION" Style="{StaticResource Label}" />
              <TextBlock Text="{x:Bind StageHint(Separation.Value), Mode=OneWay}"
                         Style="{StaticResource Label}"
                         HorizontalAlignment="Right"
                         Foreground="{StaticResource InkFaint}" />
            </Grid>
            <Slider x:Name="Separation" Minimum="0" Maximum="100" Value="0"
                    StepFrequency="1" SmallChange="5" LargeChange="20"
                    AutomationProperties.Name="Separation" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- the parts table -->
    <Border x:Name="PartsPanel"
            Grid.Column="1"
            Grid.RowSpan="2"
            Background="{StaticResource Paper}"
            BorderBrush="{StaticResource Rule}"
            BorderThickness="1"
            CornerRadius="{StaticResource Shape.Panel}"
            Padding="20">
      <Grid RowSpacing="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="10">
          <Grid>
            <TextBlock Text="PARTS LIST" Style="{StaticResource Label}" Foreground="{StaticResource Ink}" />
            <TextBlock Text="{Binding KitName}" Style="{StaticResource Label}" HorizontalAlignment="Right" />
          </Grid>
          <Border Height="1" Background="{StaticResource Rule}" />
        </StackPanel>

        <!--
            The table is the one surface that waits on the catalog, so it is the
            one FeedView. Inside ErrorTemplate and NoneTemplate the DataContext
            is not the view model, so Retry binds to the FeedView by name.
        -->
        <mvux:FeedView x:Name="TheFeed" Grid.Row="1" Source="{Binding Lines}"
                       IsTabStop="False"
                       HorizontalContentAlignment="Stretch"
                       VerticalContentAlignment="Stretch">
          <mvux:FeedView.ValueTemplate>
            <DataTemplate>
              <ScrollViewer VerticalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Disabled">
                <ItemsControl ItemsSource="{Binding Data}"
                              IsTabStop="False"
                              ItemTemplate="{StaticResource PartRowTemplate}"
                              VerticalAlignment="Top" />
              </ScrollViewer>
            </DataTemplate>
          </mvux:FeedView.ValueTemplate>

          <mvux:FeedView.ProgressTemplate>
            <DataTemplate>
              <StackPanel Spacing="1">
                <Border Height="80" Background="{StaticResource RowSelected}" />
                <Border Height="80" Background="{StaticResource RowSelected}" />
                <Border Height="80" Background="{StaticResource RowSelected}" />
                <Border Height="80" Background="{StaticResource RowSelected}" />
                <Border Height="80" Background="{StaticResource RowSelected}" />
              </StackPanel>
            </DataTemplate>
          </mvux:FeedView.ProgressTemplate>

          <mvux:FeedView.ErrorTemplate>
            <DataTemplate>
              <StackPanel Spacing="12" Padding="8,16">
                <TextBlock Text="The parts list could not be loaded." Style="{StaticResource PartName}" />
                <Button Content="Retry" Style="{StaticResource QuietButton}"
                        Command="{Binding Refresh, ElementName=TheFeed}" />
              </StackPanel>
            </DataTemplate>
          </mvux:FeedView.ErrorTemplate>

          <mvux:FeedView.NoneTemplate>
            <DataTemplate>
              <StackPanel Spacing="12" Padding="8,16">
                <TextBlock Text="No parts in this drawing." Style="{StaticResource PartName}" />
                <Button Content="Reload" Style="{StaticResource QuietButton}"
                        Command="{Binding Refresh, ElementName=TheFeed}" />
              </StackPanel>
            </DataTemplate>
          </mvux:FeedView.NoneTemplate>
        </mvux:FeedView>

        <StackPanel Grid.Row="2" Spacing="12">
          <Border Height="1" Background="{StaticResource Rule}" />
          <Grid>
            <TextBlock Text="BUILD TOTAL" Style="{StaticResource Label}" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
            <TextBlock presentation:CountUp.Amount="{Binding Total}"
                       Style="{StaticResource Money}" FontSize="17" HorizontalAlignment="Right" />
          </Grid>
          <TextBlock Text="{Binding BuildHint}" Style="{StaticResource Body}" FontSize="12" />
          <Button Style="{StaticResource PrimaryButton}"
                  Content="{Binding Action.Label, TargetNullValue='Parts list unavailable', FallbackValue='Parts list unavailable'}"
                  IsEnabled="{Binding Action.IsEnabled}"
                  Command="{Binding ToggleSelected}"
                  UseSystemFocusVisuals="True"
                  FocusVisualPrimaryBrush="{StaticResource Ink}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Page>
